---
import Badge from './Badge.astro';

export interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  badge,
  title,
  subtitle,
  align = 'center',
  class: className = '',
} = Astro.props;
---

<div class:list={[
  "mb-12 md:mb-16",
  align === 'center' ? "text-center max-w-3xl mx-auto" : "text-left max-w-2xl",
  className
]}>
  {badge && (
    <div class="mb-4">
      <Badge variant="primary" size="md">{badge}</Badge>
    </div>
  )}
  
  <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-white leading-tight">
    {title}
  </h2>
  
  {subtitle && (
    <p class="mt-4 text-base sm:text-lg text-text-secondary leading-relaxed">
      {subtitle}
    </p>
  )}
</div>
