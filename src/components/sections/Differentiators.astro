---
import Container from '../core/Container.astro';
import SectionHeader from '../core/SectionHeader.astro';
import Card from '../core/Card.astro';

const differentiators = [
  {
    title: 'Agente de IA para WhatsApp Integrado',
    description: 'O site não termina no clique. O visitante é direcionado para um assistente de IA treinado no seu modelo de negócio, capaz de qualificar o lead e agendar reuniões 24 horas por dia.',
    icon: 'ai',
  },
  {
    title: 'Schema Markup & Rich Snippets de Fábrica',
    description: 'Não cobramos dados estruturados à parte. Todas as páginas saem com JSON-LD para Organization, Services, FAQs e Breadcrumbs pré-validados no Google Rich Results.',
    icon: 'schema',
  },
  {
    title: 'Rastreamento Completo (GA4 + GTM) com Dashboard',
    description: 'Configuração completa de eventos de conversão no Google Tag Manager e GA4, acompanhado de dashboard claro para você mensurar o retorno de cada canal.',
    icon: 'analytics',
  },
  {
    title: 'Migração Segura com Mapeamento 301',
    description: 'Se sua empresa já possui um site no ar, executamos um inventário completo de URLs para redirecionamento 301, blindando sua autoridade histórica no Google.',
    icon: 'migration',
  },
  {
    title: 'Blog com Conteúdo Próprio & GEO',
    description: 'Arquitetura de blog pronta para produção contínua de artigos técnicos originais, gerando tráfego qualificado e sustentando relevância orgânica no longo prazo.',
    icon: 'blog',
  },
  {
    title: 'Velocidade de Entrega via Engenharia Ágil',
    description: 'Nosso ciclo de diagnóstico e implementação é significativamente mais rápido que agências tradicionais através do uso de ferramentas de ponta como Antigravity e Claude Code.',
    icon: 'speed',
  },
];
---

<section class="py-20 md:py-28 border-t border-border-subtle bg-background" id="diferenciais">
  <Container size="lg">
    <SectionHeader
      badge="Diferenciais de Engenharia"
      title="O que outras agências tratam como adicional, na AXION é entrega padrão."
      subtitle="Recursos técnicos desenhados para proteger seu investimento, gerar leads qualificados e manter seu negócio à frente da concorrência."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {differentiators.map((item) => (
        <Card class="flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-palette-grey-1100 border border-border-subtle flex items-center justify-center text-accent-light mb-6">
              {item.icon === 'ai' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              )}
              {item.icon === 'schema' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              )}
              {item.icon === 'analytics' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
              )}
              {item.icon === 'migration' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                </svg>
              )}
              {item.icon === 'blog' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
              )}
              {item.icon === 'speed' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              )}
            </div>

            <h3 class="text-lg font-bold text-white mb-3">
              {item.title}
            </h3>

            <p class="text-sm text-text-secondary leading-relaxed">
              {item.description}
            </p>
          </div>
        </Card>
      ))}
    </div>
  </Container>
</section>
