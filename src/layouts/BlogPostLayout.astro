---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppBridge from '../components/layout/WhatsAppBridge.astro';
import Container from '../components/core/Container.astro';
import Badge from '../components/core/Badge.astro';
import Button from '../components/core/Button.astro';
import SchemaBreadcrumbs from '../components/seo/SchemaBreadcrumbs.astro';

export interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  category: string;
  tags?: string[];
  readingTime?: string;
  author?: string;
  image?: string;
}

const {
  title,
  description,
  publishDate,
  updatedDate,
  category,
  tags = [],
  readingTime = '5 min de leitura',
  author = 'Equipe AXION',
  image,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('pt-BR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(publishDate);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": publishDate.toISOString(),
  "dateModified": (updatedDate || publishDate).toISOString(),
  "author": {
    "@type": "Organization",
    "name": "AXION",
    "url": "https://axion.com.br"
  },
  "publisher": {
    "@type": "Organization",
    "name": "AXION",
    "logo": {
      "@type": "ImageObject",
      "url": "https://axion.com.br/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": Astro.url.href
  }
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: title, url: Astro.url.pathname },
];
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedTime={publishDate.toISOString()}
  author={author}
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <SchemaBreadcrumbs items={breadcrumbs} />
  </Fragment>

  <Header />

  <article class="pt-12 pb-24">
    <!-- Post Hero -->
    <header class="border-b border-border-subtle pb-12 mb-12">
      <Container size="md">
        <!-- Breadcrumb visual -->
        <nav class="flex items-center gap-2 text-xs text-text-muted mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <span>/</span>
          <span class="text-text-secondary truncate max-w-xs">{category}</span>
        </nav>

        <div class="flex items-center gap-3 mb-6">
          <Badge variant="primary">{category}</Badge>
          <span class="text-xs text-text-muted">{readingTime}</span>
          <span class="text-xs text-text-muted">•</span>
          <time datetime={publishDate.toISOString()} class="text-xs text-text-muted">{formattedDate}</time>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight mb-6">
          {title}
        </h1>

        <p class="text-lg sm:text-xl text-text-secondary leading-relaxed font-light">
          {description}
        </p>
      </Container>
    </header>

    <!-- Post Content & Prose -->
    <Container size="md">
      <div class="prose prose-invert prose-lg max-w-none prose-headings:text-white prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-accent-light hover:prose-a:text-white prose-strong:text-white prose-code:text-accent-secondary prose-pre:bg-palette-grey-1100 prose-pre:border prose-pre:border-border-subtle prose-blockquote:border-l-accent-violet prose-blockquote:bg-palette-grey-1100/50 prose-blockquote:py-2 prose-blockquote:px-5 prose-blockquote:rounded-r-xl prose-table:border-collapse prose-th:border prose-th:border-border-subtle prose-th:p-3 prose-th:bg-palette-grey-1100 prose-td:border prose-td:border-border-subtle prose-td:p-3">
        <slot />
      </div>

      <!-- Post Footer & CTA -->
      <footer class="mt-16 pt-8 border-t border-border-subtle">
        {tags.length > 0 && (
          <div class="flex flex-wrap items-center gap-2 mb-10">
            <span class="text-xs text-text-muted">Tags:</span>
            {tags.map((tag) => (
              <Badge variant="tech" size="sm">#{tag}</Badge>
            ))}
          </div>
        )}

        <!-- CTA Box Contextual -->
        <div class="rounded-2xl bg-glass-card p-8 border border-accent-violet/30 relative overflow-hidden text-center sm:text-left sm:flex sm:items-center sm:justify-between gap-6">
          <div>
            <h2 class="text-xl font-bold text-white mb-2">Quer implementar essa arquitetura no seu negócio?</h2>
            <p class="text-sm text-text-secondary max-w-md">
              A equipe técnica da AXION analisa seu site e estrutura seu projeto com Core Web Vitals e GEO IA garantidos.
            </p>
          </div>
          <div class="mt-6 sm:mt-0 flex-shrink-0">
            <Button href="/diagnostico" variant="primary" size="md">
              Diagnóstico Gratuito &rarr;
            </Button>
          </div>
        </div>
      </footer>
    </Container>
  </article>

  <Footer />
  <WhatsAppBridge />
</BaseLayout>
